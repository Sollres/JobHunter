{
  "name": "job-hunter-web",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "app": "vite build && electron .",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "description": "Veille d'offres d'emploi avec scoring IA",
  "author": "Job Hunter",
  "main": "electron/main.cjs",
  "build": {
    "appId": "fr.jobhunter.app",
    "productName": "Job Hunter",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "server/**",
      "dist/**",
      "bridge.py",
      "jobhunter.py",
      "config.yaml",
      "cv.txt",
      "package.json",
      "build/icon.png"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
